<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Nếu máy bạn cài .NET 9 hoặc 10, đổi net8.0 thành net9.0 / net10.0 (và đổi Version của EF Core cho khớp) -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChamCongAI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SampleDocs\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Eval\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
