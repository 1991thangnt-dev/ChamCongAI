@model ChamCongThangVm
@{
    ViewData["Title"] = "Chấm công";
    var tk = Model.ThongKe;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Chấm công tháng @Model.Thang.ToString("MM/yyyy")</h3>
    <form method="get" class="d-flex gap-2">
        <input type="month" name="thang" value="@Model.Thang.ToString("yyyy-MM")" class="form-control" />
        <button class="btn btn-outline-dark">Xem</button>
    </form>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <b>Hôm nay @DateTime.Today.ToString("dd/MM/yyyy")</b><br />
            @if (Model.HomNay?.GioVao != null)
            {
                <span>Vào lúc @Model.HomNay.GioVao.Value.ToString("hh\\:mm")</span>
                @if (Model.HomNay.DiTrePhut > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">Trễ @Model.HomNay.DiTrePhut phút</span>
                }
                @if (Model.HomNay.GioRa != null)
                {
                    <span> · Ra lúc @Model.HomNay.GioRa.Value.ToString("hh\\:mm")</span>
                    @if (Model.HomNay.VeSomPhut > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">Sớm @Model.HomNay.VeSomPhut phút</span>
                    }
                }
            }
            else
            {
                <span class="text-muted">Chưa chấm công vào.</span>
            }
        </div>
        <div class="d-flex gap-2">
            <form asp-action="CheckIn" method="post"><button class="btn btn-success">Chấm công vào</button></form>
            <form asp-action="CheckOut" method="post"><button class="btn btn-outline-success">Chấm công ra</button></form>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Có mặt / ngày làm</div><div class="fs-4">@tk.SoNgayCoMat / @tk.SoNgayLamTheoLich</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Đi trễ</div><div class="fs-4">@tk.SoLanDiTre lần <span class="fs-6 text-muted">(@tk.TongPhutDiTre phút)</span></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Về sớm</div><div class="fs-4">@tk.SoLanVeSom lần <span class="fs-6 text-muted">(@tk.TongPhutVeSom phút)</span></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Nghỉ phép / vắng</div><div class="fs-4">@tk.SoNgayNghiCoPhep / @tk.SoNgayVangKhongPhep</div></div></div></div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover bg-white align-middle">
        <thead class="table-light"><tr><th>Ngày</th><th>Giờ vào</th><th>Giờ ra</th><th>Ghi chú</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Ds)
            {
                <tr>
                    <td>@c.Ngay.ToString("ddd dd/MM/yyyy")</td>
                    <td>@(c.GioVao?.ToString("hh\\:mm"))</td>
                    <td>@(c.GioRa?.ToString("hh\\:mm"))</td>
                    <td>
                        @if (c.DiTrePhut > 0) { <span class="badge bg-warning text-dark">Trễ @c.DiTrePhut phút</span> }
                        @if (c.VeSomPhut > 0) { <span class="badge bg-info text-dark">Sớm @c.VeSomPhut phút</span> }
                    </td>
                </tr>
            }
            @if (!Model.Ds.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-3">Không có dữ liệu chấm công trong tháng này.</td></tr>
            }
        </tbody>
    </table>
</div>
