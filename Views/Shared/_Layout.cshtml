<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Chấm công AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Chat" asp-action="Index">Chấm công AI</a>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Chat" asp-action="Index">Trợ lý</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ChamCong" asp-action="Index">Chấm công</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="DonNghi" asp-action="Index">Đơn nghỉ</a></li>
                    @if (User.IsInRole(VaiTro.QuanLy) || User.IsInRole(VaiTro.NhanSu))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="ChamCong" asp-action="TongHop">Tổng hợp</a></li>
                    }
                    @if (User.IsInRole(VaiTro.NhanSu))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="TaiLieu" asp-action="Index">Tài liệu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DanhGia" asp-action="Index">Đánh giá AI</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="NhatKy" asp-action="Index">Nhật ký chat</a></li>
                    }
                </ul>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-3 m-0">
                    <span class="text-white-50 small">@User.Identity.Name (@VaiTro.Ten(User.FindFirstValue(ClaimTypes.Role)))</span>
                    <button class="btn btn-sm btn-outline-light">Đăng xuất</button>
                </form>
            }
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">@TempData["Loi"]</div>
        }
        @RenderBody()
    </main>
</body>
</html>
