@model TaiLieu
@{ ViewData["Title"] = Model.TieuDe; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">@Model.TieuDe</h3>
    <a asp-action="Index" class="btn btn-link">Quay lại</a>
</div>
<p class="text-muted">Tài liệu được chia thành @Model.Doans.Count đoạn (chunk). Mỗi đoạn là một đơn vị được tìm kiếm và đưa vào ngữ cảnh cho AI.</p>

@foreach (var d in Model.Doans)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white small">
            Đoạn @d.ThuTu
            @if (d.EmbeddingJson != null) { <span class="badge bg-success ms-2">có embedding</span> }
        </div>
        <div class="card-body" style="white-space: pre-wrap">@d.NoiDung</div>
    </div>
}
